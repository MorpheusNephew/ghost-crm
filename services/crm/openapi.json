{
  "openapi": "3.1.0",
  "info": {
    "title": "Ghost CRM API",
    "version": "0.1.0",
    "description": "The API for the Ghost CRM scheduling service."
  },
  "tags": [
    {
      "name": "Events",
      "description": "Event scheduling and roster data."
    },
    {
      "name": "Ghosts",
      "description": "Ghost profile data."
    },
    {
      "name": "Overview",
      "description": "Operational dashboard data."
    },
    {
      "name": "Venues",
      "description": "Venue availability data."
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["crm"]
          },
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["service", "status"]
      },
      "EventListResponse": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": ["draft", "scheduled", "cancelled"]
                },
                "startsAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "endsAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "venue": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "address": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "name", "address"]
                },
                "ghostCount": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "title",
                "description",
                "status",
                "startsAt",
                "endsAt",
                "venue",
                "ghostCount"
              ]
            }
          }
        },
        "required": ["events"]
      },
      "EventDetailResponse": {
        "type": "object",
        "properties": {
          "event": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["draft", "scheduled", "cancelled"]
              },
              "startsAt": {
                "type": "string",
                "format": "date-time"
              },
              "endsAt": {
                "type": "string",
                "format": "date-time"
              },
              "venue": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  }
                },
                "required": ["id", "name", "address"]
              },
              "ghostCount": {
                "type": "integer",
                "minimum": 0
              },
              "roster": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "attendance": {
                      "type": "string",
                      "enum": ["pending", "attended", "no_show"]
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "name", "attendance"]
                }
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "status",
              "startsAt",
              "endsAt",
              "venue",
              "ghostCount",
              "roster"
            ]
          }
        },
        "required": ["event"]
      },
      "GhostListResponse": {
        "type": "object",
        "properties": {
          "ghosts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "imageUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "lifecycle": {
                  "type": "string",
                  "enum": ["active", "inactive"]
                },
                "threatLevel": {
                  "type": "string",
                  "enum": ["low", "moderate", "high"]
                }
              },
              "required": ["id", "name", "description", "imageUrl", "lifecycle", "threatLevel"]
            }
          }
        },
        "required": ["ghosts"]
      },
      "GhostDetailResponse": {
        "type": "object",
        "properties": {
          "ghost": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "imageUrl": {
                "type": "string",
                "format": "uri"
              },
              "lifecycle": {
                "type": "string",
                "enum": ["active", "inactive"]
              },
              "threatLevel": {
                "type": "string",
                "enum": ["low", "moderate", "high"]
              },
              "availability": {
                "type": "string",
                "enum": ["available", "assigned", "needs_review"]
              },
              "upcomingAssignment": {
                "type": "object",
                "properties": {
                  "eventId": {
                    "type": "string"
                  },
                  "eventTitle": {
                    "type": "string"
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "venue": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "address": {
                        "type": "string"
                      }
                    },
                    "required": ["id", "name", "address"]
                  }
                },
                "required": ["eventId", "eventTitle", "startsAt", "endsAt", "venue"]
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "imageUrl",
              "lifecycle",
              "threatLevel",
              "availability"
            ]
          }
        },
        "required": ["ghost"]
      },
      "OverviewResponse": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "object",
            "properties": {
              "upcomingEvents": {
                "type": "integer",
                "minimum": 0
              },
              "scheduledGhosts": {
                "type": "integer",
                "minimum": 0
              },
              "attendanceDue": {
                "type": "integer",
                "minimum": 0
              },
              "schedulingConflicts": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "upcomingEvents",
              "scheduledGhosts",
              "attendanceDue",
              "schedulingConflicts"
            ]
          },
          "nextEvent": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["draft", "scheduled", "cancelled"]
              },
              "startsAt": {
                "type": "string",
                "format": "date-time"
              },
              "endsAt": {
                "type": "string",
                "format": "date-time"
              },
              "venue": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  }
                },
                "required": ["id", "name", "address"]
              },
              "ghostCount": {
                "type": "integer",
                "minimum": 0
              },
              "roster": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "attendance": {
                      "type": "string",
                      "enum": ["pending", "attended", "no_show"]
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "name", "attendance"]
                }
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "status",
              "startsAt",
              "endsAt",
              "venue",
              "ghostCount",
              "roster"
            ]
          }
        },
        "required": ["metrics", "nextEvent"]
      },
      "VenueListResponse": {
        "type": "object",
        "properties": {
          "venues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                }
              },
              "required": ["id", "name", "address"]
            }
          }
        },
        "required": ["venues"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check CRM service health",
        "responses": {
          "200": {
            "description": "The CRM service is available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ghosts/{ghostId}": {
      "get": {
        "operationId": "getGhost",
        "summary": "Get a ghost profile",
        "tags": ["Ghosts"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "ghostId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The ghost profile and its next assignment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GhostDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "No ghost matches the identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "operationId": "getOverview",
        "summary": "Get the operations overview",
        "tags": ["Overview"],
        "responses": {
          "200": {
            "description": "The next event and its derived operational metrics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/venues": {
      "get": {
        "operationId": "listVenues",
        "summary": "List venues",
        "tags": ["Venues"],
        "responses": {
          "200": {
            "description": "The available venues.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ghosts": {
      "get": {
        "operationId": "listGhosts",
        "summary": "List ghosts",
        "tags": ["Ghosts"],
        "responses": {
          "200": {
            "description": "The available ghost profiles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GhostListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List events",
        "tags": ["Events"],
        "responses": {
          "200": {
            "description": "The available events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{eventId}": {
      "get": {
        "operationId": "getEvent",
        "summary": "Get an event",
        "tags": ["Events"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "eventId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The event and its roster.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "No event matches the provided identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
